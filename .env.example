# Required for chat and for building knowledge (never commit this file with real values)
OPENAI_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=


# Optional: owner / interview mode — message must *start* with this exact string (choose a private value).
# Strip for RAG; never commit your real production prefix if you treat it as secret.
# PORTFOLIO_OWNER_PREFIX=/owner

# Optional
# PORT=3001
# OPENAI_MODEL=gpt-4o-mini
# RATE_LIMIT_MAX=20
# CORS_ORIGIN=https://yourdomain.com   # required for production Express (npm run server) with a separate origin; not needed for Vercel same-origin /api/chat

# Vercel: set OPENAI_API_KEY (+ TAVILY_API_KEY for web search) under Project → Settings → Environment Variables, then redeploy.
# Commit server/knowledge/embeddings.json (or run build-knowledge in CI) so RAG has vectors on the serverless function.
#
# Vercel serverless rate limiting (strongly recommended for production):
# Create a Redis database at https://upstash.com — use REST URL + token here (not local Redis).
# If omitted, serverless falls back to a best-effort in-memory limiter per function instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Chat completion length (detail mode = phrases like "technical", "architecture", "stack", "compare", "FSAE", "PDM")
# MAX_COMPLETION_TOKENS=256
# MAX_COMPLETION_TOKENS_WITH_RAG=384   # floor when indexed passages are retrieved (room for quotes + answer)
# MAX_COMPLETION_TOKENS_DETAIL=2048
# RAG_TOP_K=3
# RAG_TOP_K_DETAIL=12
# RAG_MIN_SCORE=0.25
# RAG_MIN_SCORE_DETAIL=0.18

# After setting OPENAI_API_KEY, run: npm run rebuild-knowledge
# (or: npm run sync-knowledge; npm run build-knowledge in PowerShell)

# GitHub → RAG (build-knowledge)
# Create a PAT: https://github.com/settings/tokens — use "classic" with repo scope for private repos, or fine-grained with Contents read.
# GITHUB_TOKEN=                # paste token here (never commit real values); improves rate limits; raw + Contents API for private code
# GITHUB_FETCH_REPO=false      # skip all GitHub fetches (full tree + partial)
# GITHUB_FULL_TREE=true        # index filtered source tree per repo (server/lib/githubFullTreeIndex.js + server/lib/githubContentFetch.js)
# GITHUB_FULL_TREE_MAX_FILES=1500
# GITHUB_MAX_FILE_BYTES=200000
# GITHUB_FULL_TREE_MAX_CHARS=48000
# GITHUB_FULL_TREE_ALLOW_EXT=.ts,.tsx,.js,.py,.md   # comma list; omit for defaults
# GITHUB_FULL_TREE_DENY_SEGMENTS=node_modules,dist,build   # comma list; omit for defaults
# GITHUB_FETCH_DELAY_MS=50
# GITHUB_MAX_FILES_PER_REPO=12   # partial-fetch only (when GITHUB_FULL_TREE is off)
